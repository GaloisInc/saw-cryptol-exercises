/**
 * SAW demo for CTR mode.
 */

include "Speck.saw";

import "SpeckCTR.cry" as CryCtr;

/**
 * Here is an extremely common helper:
 *
 * This takes a type and value argument.
 * 1. Allocate space for a type.
 * 2. Assert that the allocation "holds" the value.
 * 3. Return the pointer to the allocation.
 */
let alloc_init ty v = do {
    p <- llvm_alloc ty;
    llvm_points_to p v;
    return p;
};


/**
 * Here is the counter update.
 */
let update_counter_setup = do {
    // here is a 128-bit counter.
    counter <- llvm_fresh_var "counter" (llvm_int 128);
    // as a "big endian" array of 64s...
    let counter64 = {{ split `{2} counter }};
    // get a pointer to that thing...
    counterPtr <- alloc_init (llvm_array 2 (llvm_int 64)) (llvm_term counter64);

    // execute the function.
    llvm_execute_func [counterPtr];

    // assert that the new state of the counter
    // is equivalent to the Cryptol specification.

    let spec = {{ split `{2} (CryCtr::updateCtr counter) }};

    llvm_points_to counterPtr (llvm_term spec);
};

// Prove that:
//
// The function "update_counter" in the "Merged" bitcode
// is equivalent to the Cryptol specification modulo some
// memory wrangling and validity preconditions.

update_counter_theorem0 <- time(llvm_verify Merged "update_counter" [] true update_counter_setup z3);

/**
 * Let's show that one round of counter mode updates the counter correctly.
 */
let ctr_one_setup = do {

    // here is a 128-bit counter.
    counter <- llvm_fresh_var "counter" (llvm_int 128);
    // as a "big endian" array of 64s...
    let counter64 = {{ split `{2} counter }};

    // here is a 256 bit key
    key <- llvm_fresh_var "key" (llvm_int 256);
    // as a "big endian" array of 64s...
    let key64 = {{ split `{4} key }};

    // here is a 128 bit plaintext, as 64s, and a pointer.
    plaintext <- llvm_fresh_var "plaintext" (llvm_int 128);
    let plaintext64 = {{ split `{2} plaintext }};
    plaintextPtr <- alloc_init (llvm_array 2 (llvm_int 64)) (llvm_term plaintext64);

    // here's something new! a pointer to a struct.
    structPtr <- alloc_init (llvm_alias "struct.Ctr") (llvm_struct_value [llvm_term key64, llvm_term counter64]);

    llvm_execute_func [structPtr, plaintextPtr];

    // the key is unchanged.
    let key64' = key64;

    // the counter has been updated.
    let counter' = {{ CryCtr::updateCtr counter }};
    let counter64' = {{ split `{2} counter' }};

    // the new struct has these updated values.

    let struct' = llvm_struct_value [llvm_term key64', llvm_term counter64'];

    llvm_points_to structPtr struct';

    // The plaintext has actually been encrypted.
    let spec = {{ split `{2} ((CryCtr::CTREncrypt key counter [plaintext]) @ 0) }};
    llvm_points_to plaintextPtr (llvm_term spec);
};

encrypt_one_theorem <- time(llvm_verify Merged "encryptCTROne" [encryptR_theorem] true ctr_one_setup (unint_z3 ["encrypt"]));


/**
 * Now let's consider running the counter updater "n times"
 * with "any" starting block.
 *
 * Why isn't this good enough to get the security property uniqueBlock'?
 */
let uniqueBlockN n = {{ \b -> CryCtr::uniqueBlock `{n} b }};

/**
 * Z3 crushes the `allDifferent` proof on the block sequence
 * for small `n` and a fixed initial value, but this won't
 * scale for large inputs (e.g., millions of bits).
 */
print "0 Blocks";
time (prove_print z3 (uniqueBlockN 0 ));
print "1 Block";
time (prove_print z3 (uniqueBlockN 1 ));
print "8 Blocks";
time (prove_print z3 (uniqueBlockN 8 ));
print "16 Blocks";
time (prove_print z3 (uniqueBlockN 16 ));
print "32 Blocks";
time (prove_print z3 (uniqueBlockN 32 ));
print "64 Blocks";
time (prove_print z3 (uniqueBlockN 64 ));
print "128 Blocks";
time (prove_print z3 (uniqueBlockN 128 ));
print "256 Blocks";
time (prove_print z3 (uniqueBlockN 256 ));

/**
 * I can't just simply uninterpret my way out of this...
 * We'll need a different strategy.
 */
let uniqueBlockN' n = {{ \k b -> CryCtr::uniqueBlock' `{n} k b }};

/**
 * Z3 can't get through many Speck encryptions without assistance.
 */
print "0 Encrypted Blocks";
time (prove_print z3 (uniqueBlockN' 0 ));
print "1 Encrypted Block";
time (prove_print z3 (uniqueBlockN' 1 ));
print "8 Encrypted Blocks";
time (prove_print z3 (uniqueBlockN' 8 ));
