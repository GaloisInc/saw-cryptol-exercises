/**
 * SAW demo for CTR mode.
 */

import "SpeckCTR.cry" as CryCtr;
CCtr <- llvm_load_module "ctr.bc";

/**
 * Here is an extremely common helper:
 *
 * This takes a type and value argument.
 * 1. Allocate space for a type.
 * 2. Assert that the allocation "holds" the value.
 * 3. Return the pointer to the allocation.
 */
let alloc_init ty v = do {
    p <- llvm_alloc ty;
    llvm_points_to p v;
    return p;
};

/**
 * Let's specify how the counter gets updated.
 */
let update_counter_setup = do {
    // here is a 128-bit counter.
    counter <- llvm_fresh_var "counter" (llvm_int 128);
    // as a "big endian" array of 64s...
    let counter64 = {{ split `{2} counter }};
    // get a pointer to that thing...
    counterPtr <- alloc_init (llvm_array 2 (llvm_int 64)) (llvm_term counter64);

    // execute the function.
    llvm_execute_func [counterPtr];

    // assert that the new state of the counter
    // is equivalent to the "straightforward"
    // bitvector addition.

    let spec = {{ split `{2} (counter + 1)}};

    llvm_points_to counterPtr (llvm_term spec);
};

// Prove that:
//
// The function "update_counter" in the "CCtr" bitcode
// is equivalent to the Cryptol specification modulo some
// memory wrangling and validity preconditions.

update_counter_theorem0 <- llvm_verify CCtr "update_counter" [] true update_counter_setup z3;


let update_counter_setup' = do {
    // here is a 128-bit counter.
    counter <- llvm_fresh_var "counter" (llvm_int 128);
    // as a "big endian" array of 64s...
    let counter64 = {{ split `{2} counter }};
    // get a pointer to that thing...
    counterPtr <- alloc_init (llvm_array 2 (llvm_int 64)) (llvm_term counter64);

    // execute the function.
    llvm_execute_func [counterPtr];

    // assert that the new state of the counter
    // is equivalent to the Cryptol specification.

    let spec = {{ split `{2} (CryCtr::updateCtr counter) }};

    llvm_points_to counterPtr (llvm_term spec);
};

llvm_verify CCtr "update_counter" [] true update_counter_setup' z3;


/**
 * Let's show that the counter actually upholds the unique block
 * property.
 */
print "Proving equivalence of `updateCtr` with `128` bit modular increment.";

/**
 * Show that 128-bit modular addition by one is exactly the counter
 * updater in the Speck CTR instance.
 */
updateCtr_theorem0 <- prove_print z3 {{ CryCtr::updateCtr === \(x: [128]) -> x + 1 }};

print "It's good!";

print "Prove some properties of the counter updater.";

let add1 = {{ \(x: [128]) -> x + 1 }};
let sub1 = {{ \(x: [128]) -> x - 1 }};

/**
 * Addition by 1 modulo 2 ^^ 128 is invertible.
 */
prove_print z3 {{ \x -> sub1 (add1 x) == x }};

/**
 * This may not seem like rocket science, but it means
 * that modular increment is a bijection...that is, it
 * is one to one...
 */
prove_print z3 {{ \x y -> (add1 x == add1 y) ==> x == y }};

/**
 * And onto...
 */
prove_print z3 {{ \x -> add1 (x - 1) == x }};

print "They're good!";

/**
 * Since the block updater is addition, it decomposes!
 */
prove_print z3 {{ \x y z -> (z == x + y) ==> (add1 z == add1 (x + y)) /\ add1 z == x + y + 1 }};

/**
 * Now let's consider running the counter updater "n times"
 * with "any" starting block.
 */
let blockSequence n b = {{ take `{n} (iterate CryCt::updateCtr `b) }};

let uniqueBlockNB n b = {{ CryCtr::allDifferent ( take `{n} (iterate CryCtr::updateCtr `b)) }};

/**
 * Z3 crushes the `allDifferent` proof on the block sequence
 * for small `n` and a fixed initial value, but this won't
 * scale for large inputs (e.g., millions of bits).
 */
print "8 Blocks";
time (prove_print z3 (uniqueBlockNB 8 0 ));
print "16 Blocks";
time (prove_print z3 (uniqueBlockNB 16 0 ));
print "32 Blocks";
time (prove_print z3 (uniqueBlockNB 32 0 ));
print "64 Blocks";
time (prove_print z3 (uniqueBlockNB 64 0 ));
print "128 Blocks";
time (prove_print z3 (uniqueBlockNB 128 0 ));
print "256 Blocks";
time (prove_print z3 (uniqueBlockNB 256 0 ));



/**
 * Here is another extremely common helper:
 *
 * This takes a "name" and type argument.
 * The name is arbitrary.
 *
 * 1. Create a fresh (Cryptol) variable of a given type.
 * 2a. Promote that variable to an LLVM one.
 * 2b. Get a pointer to that (LLVM) variable.
 * 3. Return the (Cryptol) variable and the (LLVM) pointer.
 */
let ptr_to_fresh n ty = do {
    x <- llvm_fresh_var n ty;
    p <- alloc_init ty (llvm_term x);
    return (x, p);
};

/**
 * Let's introduce a helper function to
 * get a Ctr struct. This allocates a new
 * key and arbitrary counter state.
 *
 * 1. Get a 256-bit (Cryptol) key and (LLVM) pointer.
 * 2. Get a (Cryptol) counter.
 * 3. Create a Ctr struct pointer using these (LLVM) values.
 */
let arbCtr = do {
    (key, keyP) <- ptr_to_fresh "key" (llvm_array 4 (llvm_int 64));
    counter <- llvm_fresh_var "counter" (llvm_int 64);
    CtrP <- alloc_init (llvm_alias "Ctr.s") (llvm_struct_value [keyP, llvm_term counter]);
    return (key, keyP, counter, CtrP);
};

/**
 * Let's prove that each invocation of update_counter:
 *
 * 1. Returns the "current" state.
 * 2. Increments the "internal" state.
 * 3. Is equivalent to the "counter update"
 *    portion of the updateContext spec.
 *
 * By (3) we mean specifically that:
 * 3a. The key is unchanged.
 * 3b. The counter is "1 + the current".
 *
 * Notice that 3b requires a precondition!
 *
 */
let update_counter_setup' = undefined;
