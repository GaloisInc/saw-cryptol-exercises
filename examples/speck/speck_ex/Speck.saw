// Speck SAW verification.

import "Speck128_256.cry" as CrySpeck;
CSpeck <- llvm_load_module "Speck128_256.bc";

// Some aliases.

// An LLVM integer of 64 bits and allocation types.
let uint64_t = llvm_int 64;
let keyAlloc = llvm_array 4 uint64_t;
let dataAlloc =  llvm_array 2 uint64_t; //[2][64] vs [64] -> [64]
let expAlloc = llvm_array 34 uint64_t;

let freshPtrTo myType name = do {
    x <- llvm_fresh_var name myType;
    p <- llvm_alloc myType;
    llvm_points_to p (llvm_term x);
    return (x, p);
};


// Prove equivalence of the various "rotation" code
// and the Cryptol spec.

let Sa_setup = do {
    x <- llvm_fresh_var "x" uint64_t;
    llvm_execute_func [llvm_term x];
    llvm_return (llvm_term {{ CrySpeck::Sα x }});
};

let Sb_setup = do {
    x <- llvm_fresh_var "x" uint64_t;
    llvm_execute_func [llvm_term x];
    llvm_return (llvm_term {{ CrySpeck::Sβ x }});
};

let Sai_setup = do {
    x <- llvm_fresh_var "x" uint64_t;
    llvm_execute_func [llvm_term x];
    llvm_return (llvm_term {{ CrySpeck::Sα_Inv x }});
};

let Sbi_setup = do {
    x <- llvm_fresh_var "x" uint64_t;
    llvm_execute_func [llvm_term x];
    llvm_return (llvm_term {{ CrySpeck::Sβ_Inv x }});
};

Sa_theorem <- time(llvm_verify CSpeck "Sa" [] true Sa_setup z3);
Sb_theorem <- time(llvm_verify CSpeck "Sb" [] true Sb_setup z3);
Sai_theorem <- time(llvm_verify CSpeck "Sai" [] true Sai_setup z3);
Sbi_theorem <- time(llvm_verify CSpeck "Sbi" [] true Sbi_setup z3);


// llvm world
// cryptol world

// Show the round function is equiavalent.
let R_setup = do {

    (p, p_ptr) <- freshPtrTo dataAlloc "p";

    k <- llvm_fresh_var "k" uint64_t;

    llvm_execute_func [llvm_term k, p_ptr];
 
    //Is what p_ptr is pointing to equal to the cryptol spec.

    // I am a tuple

    let cryptolResult = {{ CrySpeck::R k (p@0) (p@1) }};

    // let's turn into an array

    let cryptolSequence = llvm_term {{ [cryptolResult.0, cryptolResult.1] }};
 
    llvm_points_to p_ptr cryptolSequence;

};
 

R_theorem <- time(llvm_verify CSpeck "R" [Sai_theorem, Sb_theorem] true R_setup z3);

// Key schedule is equivalent.

let KS_setup = do {
    (key, keyPtr) <- freshPtrTo keyAlloc "key";
    (_, expPtr) <- freshPtrTo expAlloc "expansion";
    llvm_execute_func[keyPtr, expPtr];
    let result = {{CrySpeck::keySchedule key}};
    llvm_points_to expPtr (llvm_term result);
};

// This uses _overrides_. Try running this _without_ them.
// What are they doing? Ask in lab!

// TODO: Define KS_theorem (using appropriate overrides)
KS_theorem <- time(llvm_verify CSpeck "keyExpansion" [Sb_theorem, Sai_theorem] true KS_setup z3);


let Encrypt_setup = do {
    (key, keyPtr) <- freshPtrTo keyAlloc "key";
    (pt, ptPtr) <- freshPtrTo dataAlloc "pt";
    llvm_execute_func[keyPtr, ptPtr];
    let result = {{CrySpeck::encrypt key pt}};
    llvm_points_to ptPtr (llvm_term result);

};

Encrypt_theorem <- time(llvm_verify CSpeck "encrypt" [KS_theorem] true Encrypt_setup z3);