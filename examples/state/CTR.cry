module CTR where

import Primitive::Symmetric::Cipher::Block::AES::Instantiations::AES256 as AES

/**
 * Here, we say a cipher takes some
 * some k-bit key and operates on a
 * w-bit input.
 */
type Cipher k w = [k] -> [w] -> [w]

/**
 * Counter mode encrypts/decrypts a counter,
 * then XORs that with the plaintext/ciphertext.
 */
ctrOne :
    {k, w}
    (fin k, fin w)
    => Cipher k w -> [k] -> [w] -> [w] -> [w]
ctrOne cipher key currentCounter data = processedData
    where
        processedCtr = cipher key currentCounter
        processedData = data ^ processedCtr

/**
 * Counter mode can encrypt many inputs by
 * updating the counter for each block.
 * The usual way to update the counter is to
 * add one.
 *
 * In "real" counter mode, there we shouldn't
 * allow the counter to wrap. Here, we ignore
 * this.
 */
ctrMany:
    {n, k, w}
    (fin n, fin k, fin w, w >= 1)
    => Cipher k w -> [k] -> [w] -> [n][w] -> [n][w]
ctrMany cipher key start blocks = [ctrOne cipher key c b | c <- counters | b <- blocks]
    where
        // update the counter "forever"
        counters = [start, start + 1 ...]

/**
 * One deficiency of the above is that a "new"
 * counter isn't returned! That means it might
 * be easy for someone to accidentally re-use
 * a counter value. That is bad!
 *
 * This following introduces a cipher context
 * that is updated as it is used.
 *
 * The first element is the cipher, the second
 * is a fixed key, and the third is the current
 * counter. We imagine this being updated as blocks
 * are processed.
 */
type CipherContext k w = (Cipher k w, [k], [w])

/**
 * Each time we process a block, we update
 * the context like so...
 */
updateContext:
    {k, w}
    (fin k, fin w, w >= 1)
    => CipherContext k w -> CipherContext k w
updateContext (c, k, ctr) = (c, k, ctr + 1)

/**
 * Now, we return an updated context
 * in addition to the processed block.
 * Again, we don't bother to check for overflow,
 * so this is unsuitable as a "valid" counter
 * mode specification.
 */
ctrOne' :
    {k, w}
    (fin k, fin w, w >= 1)
    => CipherContext k w -> [w] -> (CipherContext k w, [w])
ctrOne' ctx data = (updateContext ctx, proc)
    where
        (c, k, ctr) = ctx
        proc = ctrOne c k ctr data

ctrMany' :
    {n, k, w}
    (fin k, fin w, w >= 1, fin n)
    => CipherContext k w -> [n][w] -> (CipherContext k w, [n][w])
ctrMany' ctx data
    | n == 0 => (ctx, []) // return the final context
    | n > 0 => (ctx'', [e] # es)
        where
            // process the first block and get the new context.
            (ctx', e) = ctrOne' ctx (head data)
            // process the rest of the blocks with the new context.
            (ctx'', es) = ctrMany' ctx' (tail data)

/**
 * We actually use the same cipher to decrypt!
 */
ctrInvertible:
    {n, k, w}
    (fin k, fin w, w >= 1, fin n)
    => Cipher k w -> [k] -> [n][w] -> Bit
ctrInvertible cipher key blocks = ctrDec == blocks
    where
        ctx0 = (cipher, key, zero)
        (finalCtx, ctrEnc) = ctrMany' ctx0 blocks
        // same initial state
        (finalCtx', ctrDec) = ctrMany' ctx0 ctrEnc


/**
 * Here is a famous encryptor.
 */
aes: [256] -> [128] -> [128]
aes = AES::encrypt

/**
 * AES Counter Mode "works".
 *
 * ```
 * :check aesCtrInvertible `{8}
 * ```
 */
aesCtrInvertible:
    {n}
    (fin n)
    => [256] -> [n][128] -> Bit
property aesCtrInvertible key blocks = ctrInvertible aes key blocks

/**
 * The "stateful" version of CTR mode is
 * the same as the one-shot version.
 *
 * This is formulated in terms of AES,
 * but is actually true for much more general
 * functions.
 *
 * ```
 * :check aesCtrEq `{1}
 * ```
 */
aesCtrEq:
    {n}
    (fin n)
    => [256] -> [128] -> [n][128] -> Bit
aesCtrEq k start data = enc0 == enc1.1
    where
        enc0 = ctrMany aes k start data
        enc1 = ctrMany' (aes, k, start) data

/**
 * ```
 * :check aesCtrIncr {2, 2}
 * ```
 */
aesCtrIncr:
    {n, m}
    (fin n, fin m)
    => [256] -> [128] -> [n + m][128] -> Bit
aesCtrIncr k start data = enc0.1 == (enc1.1 # enc2.1)
    where
        enc0 = ctrMany' (aes, k, start) data
        enc1 = ctrMany' (aes, k, start) (take `{n} data)
        enc2 = ctrMany' (enc1.0) (drop `{n} data)
