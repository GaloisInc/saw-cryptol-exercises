/**
 * Rotate a 32-bit word left by 8 bits. 
 */
rotWord : [4][8] -> [4][8]
rotWord [a,b,c,d] = [b,c,d,a]


/** 
 * Change type to 32bit
 * Hint: :? join, :? split
 * (Normally we would simply do this in SAW, but for exercise sake let's do it here)
 */
rotWord32: [32] -> [32]
rotWord32 w = undefined