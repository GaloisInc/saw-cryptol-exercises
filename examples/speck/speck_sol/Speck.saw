// Speck SAW verification.

import "Speck128_256.cry" as CrySpeck;
CSpeck <- llvm_load_module "Speck128_256.bc";

// Some aliases.

// An LLVM integer of 64 bits and allocation types.
let uint64_t = llvm_int 64;
let keyAlloc = llvm_array 4 uint64_t;
let dataAlloc =  llvm_array 2 uint64_t;
let expAlloc = llvm_array 34 uint64_t;

let freshPtrTo myType name = do {
    x <- llvm_fresh_var name myType;
    p <- llvm_alloc myType;
    llvm_points_to p (llvm_term x);
    return (x, p);
};

// The "expander" structure.
let Expander = llvm_alias "struct.Expander";

// Prove equivalence of the various "rotation" code
// and the Cryptol spec.

let Sa_setup = do {
    x <- llvm_fresh_var "x" uint64_t;
    llvm_execute_func [llvm_term x];
    llvm_return (llvm_term {{ CrySpeck::Sα x }});
};

let Sb_setup = do {
    x <- llvm_fresh_var "x" uint64_t;
    llvm_execute_func [llvm_term x];
    llvm_return (llvm_term {{ CrySpeck::Sβ x }});
};

let Sai_setup = do {
    x <- llvm_fresh_var "x" uint64_t;
    llvm_execute_func [llvm_term x];
    llvm_return (llvm_term {{ CrySpeck::Sα_Inv x }});
};

let Sbi_setup = do {
    x <- llvm_fresh_var "x" uint64_t;
    llvm_execute_func [llvm_term x];
    llvm_return (llvm_term {{ CrySpeck::Sβ_Inv x }});
};

Sa_theorem <- llvm_verify CSpeck "Sa" [] true Sa_setup z3;
Sb_theorem <- llvm_verify CSpeck "Sb" [] true Sb_setup z3;
Sai_theorem <- llvm_verify CSpeck "Sai" [] true Sai_setup z3;
Sbi_theorem <- llvm_verify CSpeck "Sbi" [] true Sbi_setup z3;

// Show the round function is equiavalent.
let R_setup = do {
    (pt, pt_ptr) <- freshPtrTo dataAlloc "plaintext";
    k <- llvm_fresh_var "k" uint64_t;
    llvm_execute_func [llvm_term k, pt_ptr];
    llvm_points_to pt_ptr (llvm_term {{ CrySpeck::R k pt }});
};

R_theorem <- llvm_verify CSpeck "R" [Sai_theorem, Sb_theorem] true R_setup z3;

// Key schedule is equivalent.

let KS_setup = do {
    (key, key_ptr) <- freshPtrTo keyAlloc "key";
    (expK, exp_ptr) <- freshPtrTo expAlloc "expanded";
    llvm_execute_func [key_ptr, exp_ptr];
    llvm_points_to exp_ptr (llvm_term {{ CrySpeck::keySchedule key }});
};

// This uses _overrides_. Try running this _without_ them.
// What are they doing? Ask in lab!

KS_theorem <- llvm_verify CSpeck "keyExpansion" [Sb_theorem, Sai_theorem] true KS_setup z3;

// Encrypt is equivalent.

let encrypt_setup = do {
    // Allocate space for the various function arguments.
    (key, key_ptr) <- freshPtrTo keyAlloc "key";
    (pt, pt_ptr) <- freshPtrTo dataAlloc "plaintext";
    (exp, expk) <- freshPtrTo expAlloc "keyexp";

    // Execute the function.
    llvm_execute_func [key_ptr, pt_ptr, expk];

    // the "plaintext" pointer now points to the ciphertext
    //
    // Notice two things:
    //
    // 1. The statement of equivalence is to a reverse key version
    // of the specification.
    //
    // 2. The Cryptol fresh variables that have been allocated
    // are sequences, but the `encrypt` function expects bitvectors.
    // We use join to match types.
    llvm_points_to pt_ptr (llvm_term {{ split `{2} (CrySpeck::encrypt (join (reverse key)) (join pt)) }});
};

// This uses a new proof technique, and it is easy to miss.
// Notice instead of "z3" as the "ProofScript" argument, I use "unint_z3".
//
// The "unint_z3" there is short for "Z3 with uninterpreted functions".
// Ask in lab about uninterpreted functions. Briefly:
//
// An uninterpreted function is interpreted by the solver (Z3) as a
// abstract symbol that could have _any_ definition that the type signature
// admits. For example, `R: [64] -> [2][64] -> [2][64]`. `R` has a "real"
// definition, but as an uninterpreted function, we pretend that `R` is
// a black box that splits out `[2][64]` when we give it a `[64]` and a `[2][64]`.
//
// The only restriction is that the solver assumes that `R` is referentially transparent.
// This means that if the solver throws in the same inputs, it must get the same output.
//
// In this way, you can understand the combination of overrides and uninterpreted functions.
//
// 1. The overrides utilize our previous proofs to assert that the C key schedule and round function
// compute the same function as the Cryptol key schedule and round function.
//
// 2. The uninterpreted function directive instructs the solver, informally speaking, to disregard
// the particular definitions of the key schedule and round function.
//
// 3. Since the specification and implementation have the same "shape", the solver is just checking
// that the inputs and outputs are being "piped along" in the same way.
encrypt_theorem <- llvm_verify CSpeck "encrypt" [KS_theorem, R_theorem] true encrypt_setup (unint_z3 ["keySchedule", "R"]);

let encryptR_setup = do {
    (key, key_ptr) <- freshPtrTo keyAlloc "key";
    (pt, pt_ptr) <- freshPtrTo dataAlloc "plaintext";
    llvm_execute_func [key_ptr, pt_ptr];
    // the "plaintext" pointer now points to the ciphertext
    llvm_points_to pt_ptr (llvm_term {{ split `{2} (CrySpeck::encrypt (join key) (join pt)) }});
};

encryptR_theorem <- llvm_verify CSpeck "encryptR" [encrypt_theorem] true encryptR_setup (unint_z3 ["encrypt"]);
