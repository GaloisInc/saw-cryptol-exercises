/**
 * SAW demo for CTR mode.
 */

include "Speck.saw";

import "SpeckCTR.cry" as CryCtr;

/**
 * Here is an extremely common helper:
 *
 * This takes a type and value argument.
 * 1. Allocate space for a type.
 * 2. Assert that the allocation "holds" the value.
 * 3. Return the pointer to the allocation.
 */
let alloc_init ty v = do {
    p <- llvm_alloc ty;
    llvm_points_to p v;
    return p;
};

/**
 * Let's specify how the counter gets updated.
 */
let update_counter_setup = do {
    // here is a 128-bit counter.
    counter <- llvm_fresh_var "counter" (llvm_int 128);
    // as a "big endian" array of 64s...
    let counter64 = {{ split `{2} counter }};
    // get a pointer to that thing...
    counterPtr <- alloc_init (llvm_array 2 (llvm_int 64)) (llvm_term counter64);

    // execute the function.
    llvm_execute_func [counterPtr];

    // assert that the new state of the counter
    // is equivalent to the "straightforward"
    // bitvector addition.

    let spec = {{ split `{2} (counter + 1)}};

    llvm_points_to counterPtr (llvm_term spec);
};

// Prove that:
//
// The function "update_counter" in the "Merged" bitcode
// is equivalent to the Cryptol specification modulo some
// memory wrangling and validity preconditions.

update_counter_theorem0 <- llvm_verify Merged "update_counter" [] true update_counter_setup z3;


let update_counter_setup' = do {
    // here is a 128-bit counter.
    counter <- llvm_fresh_var "counter" (llvm_int 128);
    // as a "big endian" array of 64s...
    let counter64 = {{ split `{2} counter }};
    // get a pointer to that thing...
    counterPtr <- alloc_init (llvm_array 2 (llvm_int 64)) (llvm_term counter64);

    // execute the function.
    llvm_execute_func [counterPtr];

    // assert that the new state of the counter
    // is equivalent to the Cryptol specification.

    let spec = {{ split `{2} (CryCtr::updateCtr counter) }};

    llvm_points_to counterPtr (llvm_term spec);
};

llvm_verify Merged "update_counter" [] true update_counter_setup' z3;

/**
 * Let's show that one round of counter mode updates the counter correctly.
 */
let ctr_one_setup = do {

    // here is a 128-bit counter.
    counter <- llvm_fresh_var "counter" (llvm_int 128);
    // as a "big endian" array of 64s...
    let counter64 = {{ split `{2} counter }};

    // here is a 256 bit key
    key <- llvm_fresh_var "key" (llvm_int 256);
    // as a "big endian" array of 64s...
    let key64 = {{ split `{4} key }};

    // here is a 128 bit plaintext, as 64s, and a pointer.
    plaintext <- llvm_fresh_var "plaintext" (llvm_int 128);
    let plaintext64 = {{ split `{2} plaintext }};
    plaintextPtr <- alloc_init (llvm_array 2 (llvm_int 64)) (llvm_term plaintext64);

    // here's something new! a pointer to a struct.
    structPtr <- alloc_init (llvm_alias "struct.Ctr") (llvm_struct_value [llvm_term key64, llvm_term counter64]);

    llvm_execute_func [structPtr, plaintextPtr];

    // the key is unchanged.
    let key64' = key64;

    // the counter has been updated.
    let counter' = {{ CryCtr::updateCtr counter }};
    let counter64' = {{ split `{2} counter' }};

    // the new struct has these updated values.

    let struct' = llvm_struct_value [llvm_term key64', llvm_term counter64'];

    llvm_points_to structPtr struct';

    // The plaintext has actually been encrypted.
    let spec = {{ split `{2} ((CryCtr::CTREncrypt key counter [plaintext]) @ 0) }};
    llvm_points_to plaintextPtr (llvm_term spec);
};

llvm_verify Merged "encryptCTROne" [encryptR_theorem] true ctr_one_setup (unint_z3 ["encrypt"]);


/**
 * Now let's consider running the counter updater "n times"
 * with "any" starting block.
 */
let uniqueBlockN n = {{ \b -> CryCtr::allDifferent ( take `{n} (iterate CryCtr::updateCtr b)) }};

/**
 * Z3 crushes the `allDifferent` proof on the block sequence
 * for small `n` and a fixed initial value, but this won't
 * scale for large inputs (e.g., millions of bits).
 */
print "0 Blocks";
time (prove_print z3 (uniqueBlockN 0 ));
print "1 Block";
time (prove_print z3 (uniqueBlockN 1 ));
print "8 Blocks";
time (prove_print z3 (uniqueBlockN 8 ));
print "16 Blocks";
time (prove_print z3 (uniqueBlockN 16 ));
print "32 Blocks";
time (prove_print z3 (uniqueBlockN 32 ));
print "64 Blocks";
time (prove_print z3 (uniqueBlockN 64 ));
print "128 Blocks";
//time (prove_print z3 (uniqueBlockN 128 ));
print "256 Blocks";
//time (prove_print z3 (uniqueBlockN 256 ));


/**
 * Let's show that the counter actually upholds the unique block
 * property.
 */
print "Proving equivalence of `updateCtr` with `128` bit modular increment.";

/**
 * Show that 128-bit modular addition by one is exactly the counter
 * updater in the Speck CTR instance.
 */
updateCtr_theorem0 <- prove_print z3 {{ CryCtr::updateCtr === \(x: [128]) -> x + 1 }};

print "It's good!";

/**
 * Let's consider the special case where the counter starts at 0.
 * This is a really common "special" case. If we aren't going to overflow,
 * then applying the counter update function makes us greater than the previous
 * value.
 */
updateCtr_theorem1 <- prove_print z3 {{ \(x: [128]) -> x < negate 1 ==> x < CryCtr::updateCtr x }};

/**
 * If the last value is the max of some sequence, and it is less than the
 * overflow bound, then the counter update of the max is the new max.
 */
let maxStatement n = {{ \(x:[n][128]) -> last x < negate 1 /\ CryCtr::lastMax x ==> CryCtr::lastMax (x # [CryCtr::updateCtr (last x)])}};

maxTheorem1 <- prove_print z3 (maxStatement 1);
maxTheorem2 <- prove_print z3 (maxStatement 2);

let maxStatement' n = {{ CryCtr::lastPred `{n} }};

maxTheorem1' <- prove_print z3 (maxStatement 1);
maxTheorem2' <- prove_print z3 (maxStatement 2);



/**
 * Let's consider the allDifferent predicate.
 */
allDifferent0 <- prove_print z3 {{ CryCtr::allDifferent `{a=[128]} [] }};
allDifferent1 <- prove_print z3 {{ \x -> CryCtr::allDifferent `{a=[128]} [x] }};
allDifferent2 <- prove_print z3 {{ \x -> CryCtr::allDifferent `{a=[128]} [x, CryCtr::updateCtr x]}};


print "Prove some properties of the counter updater.";

let add1 = {{ \(x: [128]) -> x + 1 }};
let sub1 = {{ \(x: [128]) -> x - 1 }};

/**
 * Addition by 1 modulo 2 ^^ 128 is invertible.
 */
prove_print z3 {{ \x -> sub1 (add1 x) == x }};

/**
 * This may not seem like rocket science, but it means
 * that modular increment is a bijection...that is, it
 * is one to one...
 */
prove_print z3 {{ \x y -> (add1 x == add1 y) ==> x == y }};

/**
 * And onto...
 */
prove_print z3 {{ \x -> add1 (x - 1) == x }};

/**
 * The contrapositive of the one to one property is useful...
 */
prove_print z3 {{ \x y -> x != y ==> add1 x != add1 y }};

/**
 * ...and the block updater also decomposes like so...
 * ...this will help us deal with offsets.
 */
prove_print z3 {{ \x y -> add1 (x + y) == add1 x + y }};

/**
 * In particular, the above gives for any sequence b, b + 1, ...
 * we may instead consider 0, 1, ... and add the offset.
 *
 * map add1 [b, b + 1, ...]
 * [add1 b, add1 (b + 1), ...]
 * [add1 (0 + b), add1 (1 + b), ...]
 * [add1 0 + b, add1 1 + b, ...]
 * map (\i -> i + b) [add1 0, add1 1, ...]
 * map (\i -> i + b) (map add1 [0, 1, ...])
 */
let offsetEq n = {{ \b -> map add1 (take `{n} [b : [128], b + 1 ...]) == take `{n} (map (\i -> i + b) (map add1 [0, 1 ...]))}};

prove_print z3 (offsetEq 128);

/**
 * The one to one property gives us that if we have any set
 * of distinct 128 bit values, mapping updateCtr over the set
 * maintains the property.
 */
let updateCtrPreservesAllDifferent n = {{ \(x: [n][128]) -> CryCtr::allDifferent x ==> CryCtr::allDifferent (map add1 x)}};

prove_print z3 (updateCtrPreservesAllDifferent 8);
prove_print z3 (updateCtrPreservesAllDifferent 16);





print "They're good!";

/**
 * Since the block updater is addition, it decomposes!
 */
prove_print z3 {{ \x y z -> (z == x + y) ==> (add1 z == add1 (x + y)) /\ add1 z == x + y + 1 }};
