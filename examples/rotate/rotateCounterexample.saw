
import "rotate.cry" as specification;
implementation <- llvm_load_module "rotate.bc";

let badReturn = do {
    x <- llvm_fresh_var "x" (llvm_int 8);
    r <- llvm_fresh_var "r" (llvm_int 8);
    llvm_execute_func [llvm_term x, llvm_term r];
    llvm_return (llvm_term {{ specification::rotl' x r }});
};

counterexample <- llvm_verify implementation "rotl" [] false badReturn z3;
